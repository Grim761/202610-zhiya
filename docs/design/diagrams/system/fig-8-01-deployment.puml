@startuml
' ZHIYA v1.1 | 2026-11-04 | local PlantUML / Graphviz
' Final SVG/PNG: run 13-15-route.py for deterministic independent ports.
skinparam backgroundColor white
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 0
skinparam dpi 220
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam packageTitleAlignment left
skinparam linetype polyline
skinparam nodesep 14
skinparam ranksep 5
skinparam padding 0
skinparam defaultTextAlignment center
skinparam monochrome true
hide empty members
top to bottom direction
node "手机 / 电脑浏览器" as CLIENT {
 artifact "Vue 静态页" as SPA
}
node "Linux 云服务器 · Docker Compose" as SERVER {
 node "反向代理容器" as PROXY {
  artifact "静态文件 / HTTPS 入口" as NGINX
 }
 node "单工作进程应用容器" as APP {
  artifact "FastAPI · 业务 / Agent / 语音" as API
 }
 folder "持久化卷" as VOL {
  database "SQLite 数据文件" as DB
  artifact "授权图片与审核音频" as RES
 }
 folder "临时目录\n录音处理后销毁" as TMP
}
cloud "外部模型\n与语音服务" as CLOUD
node "隔离备份位置" as BACKUP
CLIENT --> SERVER : HTTPS 443
PROXY --> APP : 内部 HTTP
APP --> DB : 本地事务
APP --> RES : 资源鉴权
APP --> TMP : 临时读写
APP -right-> CLOUD : HTTPS\n服务端密钥
DB ..> BACKUP
RES ..> BACKUP

@enduml
