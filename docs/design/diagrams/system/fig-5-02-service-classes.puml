@startuml
' ZHIYA v1.1 | 2026-11-04 | local PlantUML / Graphviz
skinparam backgroundColor white
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 0
skinparam dpi 220
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam packageTitleAlignment left
skinparam linetype polyline
skinparam nodesep 32
skinparam ranksep 35
skinparam padding 6
skinparam defaultTextAlignment center
skinparam monochrome true
hide empty members
skinparam linetype polyline
skinparam nodesep 28
skinparam ranksep 32
hide circle
top to bottom direction
class ReadingSessionService {
 +create_session()
 +append_event()
 +ask_question()
 +request_guidance()
 +finish_session()
}
class ReadingAgent {
 +ask()
 +guide()
 +generate_story()
}
class BranchService {
 +select_branch()
 +validate_graph()
}
class StorybookService {
 +list_available()
 +approve_version()
 +withdraw()
}
class KnowledgeService {
 +retrieve()
}
class SafetyValidator {
 +validate_input()
 +validate_output()
}
class VoiceService {
 +transcribe()
 +synthesize()
}
class ModelGateway {
 +generate()
}
class Repository {
 +load_owned_session()
 +claim_request()
 +commit_branch()
 +commit_event_and_response()
}
ReadingSessionService .down.> BranchService
ReadingSessionService .down.> Repository
ReadingSessionService .down.> ReadingAgent
BranchService .right.> Repository
Repository -[hidden]right- ReadingAgent
BranchService .down.> StorybookService
ReadingAgent .down.> KnowledgeService
ReadingAgent .down.> ModelGateway
KnowledgeService -[hidden]right- ModelGateway
KnowledgeService .up.> Repository
ReadingAgent ..> SafetyValidator
StorybookService ..> SafetyValidator
VoiceService .right.> SafetyValidator

@enduml
