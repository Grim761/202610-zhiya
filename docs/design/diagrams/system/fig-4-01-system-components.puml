@startuml
' ZHIYA v1.1 | 2026-11-04 | local PlantUML / Graphviz
skinparam backgroundColor white
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 0
skinparam dpi 220
skinparam ArrowColor #334155
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam packageTitleAlignment left
skinparam linetype polyline
skinparam nodesep 32
skinparam ranksep 35
skinparam padding 6
skinparam defaultTextAlignment center
skinparam monochrome true
hide empty members
top to bottom direction
package "客户端" {
 component "家长与儿童页面\nVue 3 + Vite" as WEB
 component "管理员页面\nVue 3" as ADMIN
}
package "知芽后端部署单元  FastAPI" {
 component "认证与权限\nAuthService" as AUTH
 component "业务服务\n档案 / 绘本 / 阅读 / 小结" as BIZ
 component "领域智能体\nReadingAgent" as AGENT
 component "知识检索\nKnowledgeService" as KNOW
 component "语音适配\nVoiceService" as VOICE
 component "数据访问\nRepository" as REPO
}
database "SQLite\n业务数据与知识条目" as DB
folder "受控资源目录\n图片 / 审核音频" as FILE
cloud "外部模型服务\nLLM / ASR / TTS" as CLOUD
WEB .down.> AUTH
ADMIN .down.> AUTH
WEB -[hidden]right-> ADMIN
AUTH .right.> BIZ : 鉴权分派
BIZ ..> AGENT : 受控任务
AGENT ..> KNOW : 知识检索
BIZ ..> VOICE : 语音处理
BIZ ..> REPO
KNOW .right.> REPO
REPO ..> DB
BIZ ..> FILE
AGENT ..> CLOUD : 模型\n调用
VOICE ..> CLOUD : 识别 / 合成

AGENT -[hidden]right- VOICE

@enduml
